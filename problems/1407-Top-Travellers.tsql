SELECT U.name,
        ISNULL(SUM(R.distance), 0) AS travelled_distance
FROM Users U
    LEFT OUTER JOIN Rides R
        ON U.id = R.user_id
Group by U.id, U.name
ORDER BY travelled_distance DESC, U.name ASC

